{
  "name": "playmat-maker",
  "version": "1.3.0",
  "description": "Editor de playmats personalizados para Digimon Card Game",
  "main": "electron/main.cjs",
  "author": "Playmat Maker",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:web": "tsc -b && vite build",
    "build": "tsc -b && vite build && electron-builder --win portable",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:smoke": "npm run build:web && electron scripts/smoke-test.cjs"
  },
  "dependencies": {
    "konva": "^9.3.22",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-konva": "^19.0.10"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.playmatmaker.app",
    "productName": "Playmat Maker",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Playmat-Maker-${version}-Portable.${ext}"
    },
    "portable": {
      "artifactName": "Playmat-Maker-${version}-Portable.${ext}"
    }
  }
}
